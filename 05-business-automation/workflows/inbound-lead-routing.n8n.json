      "typeVersion": 2.1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Simplified fit + engagement scoring (full model: 04-lead-generation/lead-scoring-model.md)\nconst industryPts = { Healthcare: 15, BFSI: 12, Retail: 10, Manufacturing: 10, Automotive: 10 };\nreturn $input.all().map(item => {\n  const { body = {}, ...enrichment } = item.json;  // form fields + enrichment fields\n  const l = { ...enrichment, ...body };\n  const title = (l.title || '').toLowerCase();\n  const has = (words) => words.some(w => new RegExp(`\\\\b${w}\\\\b`).test(title));\n  const emp = Number(l.employees || 0);\n  let fit = industryPts[l.industry] || 0;\n  fit += emp >= 1000 ? 10 : emp >= 500 ? 7 : emp >= 200 ? 4 : 0;\n  fit += has(['chief', 'cio', 'cfo', 'ceo', 'cto', 'president']) ? 20\n       : has(['vp', 'head']) ? 17 : has(['director']) ? 14 : has(['manager', 'lead']) ? 8 : 0;\n  let engagement = 0;\n  if (l.demo_requested) engagement += 15;\n  if (l.webinar_attended) engagement += 7;\n  if (l.pricing_page_visit) engagement += 8;\n  const score = Math.min(fit, 50) + Math.min(engagement, 50);\n  return { json: { ...l, fit, engagement, score, grade: fit < 20 ? 'D' : score >= 80 ? 'A' : score >= 60 ? 'B' : 'C' } };\n});"
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Score Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
